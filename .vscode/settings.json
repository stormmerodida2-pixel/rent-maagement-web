{
  // Hide files that clutter the explorer. Nothing here is deleted:
  // - __pycache__, *.pyc and .ruff_cache are regenerated by Python and the linter.
  // - Tests still run (python manage.py test, and on every push before deploying); they're just out of sight.
  //   To see them again, remove the two test lines below, or use the search box.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".ruff_cache": true,
    "**/tests": true,
    "**/tests.py": true
  }
}
