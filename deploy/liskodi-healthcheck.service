[Unit]
Description=Liskodi: check the live site and send an alert if something is wrong
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
# Uses the newest deploy/healthcheck.sh from main (does nothing until main contains it).
ExecStart=/bin/bash -c 'cd /home/ubuntu/app && if git cat-file -e origin/main:deploy/healthcheck.sh 2>/dev/null; then exec bash <(git show origin/main:deploy/healthcheck.sh); fi'
TimeoutStartSec=2min
