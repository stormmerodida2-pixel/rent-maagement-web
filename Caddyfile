# Caddy gets and renews HTTPS certificates automatically for $DOMAIN
# (the domain's DNS must point at this server, with ports 80 and 443 open).
{$DOMAIN} {
	encode zstd gzip

	# Uploaded photos (listing pictures), straight from the shared volume.
	handle_path /media/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=604800"
		header X-Content-Type-Options nosniff
	}

	handle {
		reverse_proxy web:8000
	}
}
