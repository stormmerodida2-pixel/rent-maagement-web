DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# M-Pesa: each landlord connects their own Paybill/Till and Daraja app in the app
# (Settings -> M-Pesa). Only the public webhook base URL is configured here.
# Public HTTPS base URL Safaricom can reach, e.g. https://abc123.ngrok-free.app
MPESA_CALLBACK_BASE_URL=

# Encrypts landlords' Daraja credentials at rest. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Public URL of this site, used in tenant portal links sent by SMS
SITE_URL=http://localhost:8000

# SMS: 'console' just logs; 'africastalking' sends for real
SMS_BACKEND=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
SMS_PAYMENT_RECEIPTS=1
APP_NAME=Liskodi

# Email (verification and password reset). Leave EMAIL_HOST empty to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Liskodi <no-reply@example.com>

# Where messages from the Contact us page are emailed (you, the people running the site)
SUPPORT_EMAIL=
