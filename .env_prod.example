# The live site. Copy to .env_prod on the server, fill in every value, then:
#   docker compose --env-file .env_prod up -d --build
# Read by settings/production.py. .env_prod is never committed.

# --- Required ---------------------------------------------------------------------------------
DOMAIN=rent.example.com
SITE_URL=https://rent.example.com
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe: without it, saved M-Pesa credentials can't be decrypted.
FIELD_ENCRYPTION_KEY=
# Encrypts every backup (generate the same way). Store it OFF the server, in a password manager:
# it's what lets you read a backup if the server is lost.
BACKUP_ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- Email (verification, password reset, notifications) -------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Liskodi <no-reply@rent.example.com>
SUPPORT_EMAIL=you@example.com

# --- SMS (Africa's Talking) --------------------------------------------------------------------
SMS_BACKEND=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Optional ------------------------------------------------------------------------------------
APP_NAME=Liskodi
# Error alerts: create a free project at sentry.io and paste its DSN.
SENTRY_DSN=
# Raise to 31536000 (one year) once you've confirmed HTTPS works.
DJANGO_HSTS_SECONDS=3600
BACKUP_KEEP_DAYS=14
# Log people out after this many minutes without activity.
SESSION_IDLE_MINUTES=60
# Set to 1 to test a Content-Security-Policy change without blocking anything.
CSP_REPORT_ONLY=0
WEB_CONCURRENCY=3
# Safaricom's callback addresses (IPs or CIDR ranges). Production M-Pesa callbacks from anywhere
# else aren't trusted: Paybill payments are held for review and STK results are confirmed with
# Safaricom instead. Leave unset to use Safaricom's published list; only change it if Safaricom
# publishes new addresses. "any" turns the check off (not recommended).
# MPESA_CALLBACK_IPS=

# --- Legal (shown on /privacy/ and /terms/) -------------------------------------------------------
# Your registered business name and postal/physical address, and where data-protection requests go.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
PRIVACY_EMAIL=
